#!/bin/sh
set -eu

if [ "${1-}" = "--version" ]; then
  echo "skill-validator v1.6.0"
  exit 0
fi

skill_path="$5"
tokens="$(printenv FAKE_VALIDATOR_TOKENS 2>/dev/null || echo 100)"
if printf '%s' "$skill_path" | grep -q '/invalid'; then
  echo '{"passed":false,"errors":1,"warnings":0,"token_counts":{"files":[{"file":"SKILL.md body","tokens":100}]}}'
  exit 1
fi

echo '{"passed":true,"errors":0,"warnings":0,"token_counts":{"files":[{"file":"SKILL.md body","tokens":'"$tokens"'}]}}'
